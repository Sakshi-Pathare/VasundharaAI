# ==============================================================================
# Vasundhara AI — Production Environment Template
# Copy to .env.production and provide high-entropy secrets before deployment.
# ==============================================================================

# Application Environment Mode
ENVIRONMENT=production

# Database Configuration (PostgreSQL 15+)
POSTGRES_DB=vasundhara_prod
POSTGRES_USER=vasundhara_db_admin
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_32_CHARS

# Backend Connection String (automatically interpolated in docker-compose.prod.yml)
DATABASE_URL=postgresql+psycopg://vasundhara_db_admin:REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_32_CHARS@db:5432/vasundhara_prod

# Production Allowed Origins (Strict HTTPS origins; no wildcards)
CORS_ORIGINS=https://app.vasundhara.eco,https://admin.vasundhara.eco

# Platform Super-Administrator Initial Seed Account
VASUNDHARA_SUPERADMIN_EMAIL=superadmin@vasundhara.eco
# Generate with: openssl rand -base64 24
VASUNDHARA_SUPERADMIN_PASSWORD=REPLACE_WITH_SUPERADMIN_SECURE_PASSWORD

# Image Storage & Quotas
UPLOAD_DIR=/app/uploads
MAX_IMAGE_BYTES=8388608

# Logging Level (INFO for production)
LOG_LEVEL=INFO

# Geospatial Buffer
JURISDICTION_BOUNDARY_MARGIN_METERS=25.0

# Optional Model Path (leave unset if using runtime heuristic fallback)
YOLO_MODEL_PATH=/app/models/yolov8_waste.pt
