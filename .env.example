# ==============================================================================
# Vasundhara AI — Frontend Environment Configuration
# ==============================================================================

# API Base URL for HTTP requests
# In local development, the Vite dev server proxies '/api' and '/static' to the FastAPI backend
VITE_API_BASE_URL=/api/v1

# Target URL for the Vite development reverse proxy (FastAPI backend server)
# Change this if your FastAPI server is listening on a different host or port
VITE_API_PROXY_TARGET=http://localhost:8001

# API request timeout in milliseconds (default: 15000 = 15 seconds)
VITE_API_TIMEOUT_MS=15000

# Explicit development-only mock toggle
# CRITICAL RULE: In production builds, mock data is strictly disabled.
# Set to 'true' ONLY when running 'npm run dev' completely offline without backend.
VITE_ENABLE_MOCK=false
