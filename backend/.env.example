# ==============================================================================
# Vasundhara AI — Backend Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Server Host and Port
API_HOST=0.0.0.0
API_PORT=8001

# Database Configuration
# Default (Local Development): SQLite file inside backend/ecowatch.db (WAL mode automatically applied)
# Production (PostgreSQL): postgresql+psycopg://username:password@localhost:5432/vasundhara_db
DATABASE_URL=sqlite:///backend/ecowatch.db

# CORS Allowed Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Required Super-Administrator Bootstrap Credentials (minimum 12 chars password)
# These will seed the initial platform superadmin account on startup if not present.
ECOWATCH_SUPERADMIN_EMAIL=admin@vasundhara.eco
ECOWATCH_SUPERADMIN_PASSWORD=VasundharaAdmin2026!

# Upload Directory & Payload Limits
UPLOAD_DIR=backend/uploads
MAX_IMAGE_BYTES=8388608

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Geospatial Boundary Buffer Margin (meters)
JURISDICTION_BOUNDARY_MARGIN_METERS=25.0

# Optional YOLO Litter Model Path (leave empty for manual classification)
# YOLO_MODEL_PATH=models/yolov8_litter.pt
